# ============================================================
# AI Manager - 環境変数テンプレート
# このファイルを .env にコピーして値を埋めてください。
# .env は絶対に git にコミットしないこと（.gitignore 済み）。
# ============================================================

# --- Claude API (Anthropic) ---
# https://console.anthropic.com/ で取得
CLAUDE_API_KEY=

# --- Gemini API (Google) ---
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=

# --- Google OAuth (Calendar / Gmail) ---
# https://console.cloud.google.com/apis/credentials で OAuth クライアント(デスクトップ)を作成し、
# client_secret.json を config/ に保存。トークンは初回実行時にブラウザ認証で自動生成される。
GOOGLE_OAUTH_CLIENT_SECRET_PATH=config/google_client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=config/google_token.json

# --- Meta Graph API (Facebook / Instagram) ---
# https://developers.facebook.com/apps/ でアプリ作成 → Graph API Explorer で
# 長期(60日)ページアクセストークンを発行して設定
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_GROUP_ID=
FACEBOOK_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_AD_ACCOUNT_ID=

# --- Slack (通知先) ---
# https://api.slack.com/apps → Incoming Webhook を有効化して発行
SLACK_WEBHOOK_URL=

# --- NOTE (note.com) ---
# 注意: note.com には公開の投稿 API は存在しない(2026年9月時点)。
# 現状は「下書き自動生成 → 人による確認・手動貼り付け」を正式フローとする。
# 将来的にブラウザ自動化(Playwright)で下書き投稿まで自動化する場合は
# NOTE_EMAIL / NOTE_PASSWORD をここに追加する設計にしてあるが、Phase 0 では未使用。
NOTE_EMAIL=
NOTE_PASSWORD=

# --- 実行設定 ---
# 複数事業の表示名(カンマ区切り)
BUSINESSES=TheVintageSalon,airstobu,GoldenMUGI

# 朝の指示書の実行時刻 (HH:MM, 24h)
MORNING_BRIEF_TIME=06:30

# ログレベル
LOG_LEVEL=INFO

# 出力先: slack | console | both
OUTPUT_CHANNEL=both
